# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/campuscapsule

# Authentication
JWT_ACCESS_SECRET=dev_access_secret_campuscapsule_secure_jwt_key_32chars
JWT_REFRESH_SECRET=dev_refresh_secret_campuscapsule_secure_token_key_32chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS
CORS_ORIGIN=*
